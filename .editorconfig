# .editorconfig - shared formatting rules for the Flutter project
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

# Do not trim trailing spaces in Markdown files
[*.md]
trim_trailing_whitespace = false

# YAML files (pubspec.yaml etc.)
[*.yaml]
indent_size = 2
